<mxfile host="app.diagrams.net">
  <diagram name="AcousticSpace Architecture" id="acousticspace-arch">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Browser -->
        <mxCell id="browser" value="Browser" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="580" y="40" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- Vercel -->
        <mxCell id="vercel" value="Vercel&#10;Frontend (React + Vite, static)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="380" y="180" width="240" height="70" as="geometry" />
        </mxCell>

        <!-- Render backend -->
        <mxCell id="render" value="Render&#10;Backend (FastAPI + Docker)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="740" y="180" width="240" height="70" as="geometry" />
        </mxCell>

        <!-- Render postgres -->
        <mxCell id="pg" value="Render PostgreSQL&#10;(production database)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="740" y="320" width="240" height="60" as="geometry" />
        </mxCell>

        <!-- ML pipeline -->
        <mxCell id="ml" value="ML Pipeline&#10;librosa + CNN (deepfake_cnn.pth)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="740" y="420" width="240" height="60" as="geometry" />
        </mxCell>

        <!-- Local stack group -->
        <mxCell id="localbox" value="Self-hosted / local stack (docker-compose)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;verticalAlign=top;fontStyle=1;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="180" width="260" height="380" as="geometry" />
        </mxCell>

        <mxCell id="nginx" value="nginx (:80)&#10;reverse proxy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="100" y="230" width="180" height="60" as="geometry" />
        </mxCell>

        <mxCell id="fe-local" value="frontend container&#10;(static build)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="90" y="330" width="110" height="60" as="geometry" />
        </mxCell>

        <mxCell id="be-local" value="backend container&#10;FastAPI :8000" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="210" y="330" width="90" height="60" as="geometry" />
        </mxCell>

        <mxCell id="db-local" value="SQLite (dev only)&#10;/ Postgres" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="120" y="430" width="150" height="60" as="geometry" />
        </mxCell>

        <!-- edges -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="browser" target="vercel">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e1b" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="browser" target="nginx">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="/api/*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="vercel" target="render">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="render" target="pg">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="render" target="ml">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="nginx" target="fe-local">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="/api/*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="nginx" target="be-local">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="be-local" target="db-local">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
